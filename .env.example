# Supabase ayarları (İSTEĞE BAĞLI)
# Bu dosya sadece ÖRNEKTİR; gerçek anahtar buraya yazılmaz.
#
# Kullanım:
#   1) Bu dosyayı ".env" adıyla kopyala
#   2) Aşağıdaki iki değeri Supabase panelinden al (Project Settings > API)
#   3) node araclar/env-aktar.js   -> js/ayarlar.js dosyasını üretir
#
# ".env" ve "js/ayarlar.js" .gitignore'dadır; depoya girmez.
# Bu dosya hiç doldurulmazsa uygulama localStorage ile çalışmaya devam eder.

SUPABASE_URL=https://PROJE-KODUN.supabase.co
SUPABASE_ANON_KEY=BURAYA-ANON-PUBLIC-ANAHTAR
